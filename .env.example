# Kies: ntfy, telegram, stdout, of een combinatie zoals ntfy,telegram
NOTIFY_MODE=ntfy

# NTFY: maak een lange, niet te raden topicnaam en abonneer die in de ntfy-app.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=vervang-dit-door-een-lange-willekeurige-topicnaam

# TELEGRAM (alleen nodig als NOTIFY_MODE telegram bevat)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# De monitor staat al vast op Heemstede en echte garage-termen.
TARGET_CITY=Heemstede
GARAGE_TERMS=garage,garagebox,garage-box,autobox,garage-unit

# Controle-interval. 30 seconden is snel zonder de site extreem te belasten.
POLL_INTERVAL_SECONDS=30

# Bij false worden bestaande treffers bij de eerste start alleen als nulmeting opgeslagen.
NOTIFY_EXISTING_ON_FIRST_RUN=false

# Normaal niet aanpassen.
OFFER_URL=https://mijnwoonservice.mijndak.nl/Woningaanbod
STATE_FILE=/data/state.json
PERSIST_LAST_SUCCESSFUL_CHECK=true
BROWSER_CHANNEL=
HEADLESS=true
LOG_LEVEL=info
